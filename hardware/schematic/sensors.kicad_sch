	(label "I2C_SDA" (at 78.74 153.67 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "7b847248-db88-4357-a70c-b0d0e9d14f08"))
	(label "I2C_SCL" (at 78.74 156.21 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "6e6db127-84de-4995-93ac-a291caeb566e"))
	(hierarchical_label "TEMP_INT" (shape output) (at 132.08 153.67 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "32d049d9-0319-4f16-9459-5743f8349a8e"))
	(text_box "BMI270: I2C address 0x68 because SDO is tied to ground. CSB high selects I2C. ASDx and ASCx (the secondary interface) are tied to VDDIO as the datasheet requires, never to ground. OCSB and OSDO are not used." (exclude_from_sim no) (at 160.02 35.56 0) (size 78 8.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a44d67d0-76e2-44f9-a627-9a69487f509b"))
	(text_box "C19 and C20 are decoupling capacitors for BMI270 VDD and VDDIO (100 nF each). Keep them close to the pins." (exclude_from_sim no) (at 160.02 46.76 0) (size 78 6.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "616364f7-da2b-4346-aa52-0dcc9d448fb5"))
	(text_box "MAX30208: address 0x50. GPIO1 is tied to ground, and GPIO0 reads low at start-up through its internal 1 MOhm pull-down, so the address stays 0x50. GPIO0 is the temperature alarm output (TEMP_INT), open drain and active low in INTB mode: set that mode first, then enable the processor's internal pull-up on P2.03. Do NOT add an external pull-up, it would change the address. All three VDD pins and all three GND pins are connected." (exclude_from_sim no) (at 160.02 124.46 0) (size 78 16.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d9f7d23a-7c07-40fd-9de0-896b07d2ffda"))
	(text_box "C21 decouples MAX30208 VDD (100 nF). Keep it close to the pins. Read PCN 2204 before ordering." (exclude_from_sim no) (at 160.02 143.66 0) (size 78 6.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c79c721e-f37a-4ee8-9a55-6f1445b70d5c"))
	(text_box "One pair of 4.7 kOhm pull-ups serves the whole bus. At 400 kHz and about 50 pF the rise time is about 0.2 us. The nPM1300 joins this bus on the power sheet." (exclude_from_sim no) (at 160.02 78.74 0) (size 78 8.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fdff168c-cbea-41ad-b079-75b022434ca1"))
