	(text_box "Tag-Connect TC2030-NL pin order (to be confirmed against the cable drawing): 1 VTREF, 2 SWDIO, 3 nRESET, 4 SWDCLK, 5 GND, 6 SWO. VTREF takes the 1.8 V rail so the programmer senses the target voltage." (exclude_from_sim no) (at 160.02 35.56 0) (size 50 12.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ac9192ee-eae8-46af-bcba-c44f18b98210"))
	(text_box "Test points are plain 1.0 mm pads. Put them on one side of the board where the production fixture can reach them (research/storage-nfc-dft/DFT_PROGRAMMING.md). The bus test points sit on the sheets that own the bus: I2C on the sensors sheet, SPI on the memory sheet, PPG_INT on the optical sheet." (exclude_from_sim no) (at 160.02 50.76 0) (size 50 16.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4fe14695-3b0b-4f26-8945-cd999d06d3dd"))
	(text_box "Open items: confirm the Tag-Connect pin order, and decide which test points stay on the final board." (exclude_from_sim no) (at 160.02 69.96 0) (size 50 8.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3afec3fd-894d-4a2b-9fc9-273622c55159"))
