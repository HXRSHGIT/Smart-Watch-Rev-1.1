	(text "LED supply: 5.0 V boost (TPS61240) with a direct link to VSYS for comparison" (exclude_from_sim no) (at 15.0 18.0 0) (effects (font (size 2.54 2.54) bold) (justify left bottom)) (uuid "9dd3b4e4-b79b-4dca-81c3-389ca72668ff"))
	(text "Fit ONE of the two 0R links: boost output to VLED (default) or VSYS to VLED (power tree option A)." (exclude_from_sim no) (at 15.0 25.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "91c0d710-45f7-497d-8580-0e3dbf16ac46"))
	(text "TPS61240: L = 1.0 uH min, CIN 2.2 uF, COUT effective 2.7 uF min at 5 V (datasheet 10.2.2). EN high level 1.0 V, so 1.8 V logic is enough." (exclude_from_sim no) (at 15.0 29.5 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b2540235-2bbf-43a6-ae64-6687bcfd5c2c"))
	(text "EN has a 100 kOhm pull-down so the boost is off while the processor pins float (errata 103)." (exclude_from_sim no) (at 15.0 34.0 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d0c85d6e-2a08-4aee-b1f6-31c6e7066214"))
