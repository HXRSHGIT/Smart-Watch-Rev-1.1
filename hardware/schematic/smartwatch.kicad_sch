	(label "I2C_SCL" (at 231.14 96.52 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "4d2ec319-7cd8-4cfd-9a92-d188620c420d"))
	(text_box "How to read this page: each box is one sheet. A wire between two boxes is a signal that crosses sheets. SPI_SCK, SPI_MOSI and SPI_MISO serve the optical sheet and the memory sheet; I2C_SDA and I2C_SCL serve the sensors sheet and the power sheet. The second receiver of each of these five nets is joined by name (label) because a wire would cross other signals." (exclude_from_sim no) (at 299.72 35.56 0) (size 80 12.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ab8ee837-be58-4486-abed-7c5d51604fdd"))
	(text_box "Power: the charger input (VBUS_PROT) from the charging input sheet, the battery, VSYS and the 1.8 V rail are power symbols, so they connect by name across sheets and do not appear as wires here. The nPM1300 on the power sheet makes VSYS and the 1.8 V rail." (exclude_from_sim no) (at 299.72 50.76 0) (size 80 10.2) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.1524) (type solid) (color 200 0 0 1)) (fill (type color) (color 160 195 245 1)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1839890c-ee54-41f2-9a30-74bcd9c539cc"))
